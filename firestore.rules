rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidProduct(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 200
        && p.price is number && p.price >= 0
        && p.category is string && p.category.size() <= 100
        && (!('stock' in p) || p.stock is number)
        && (!('description' in p) || (p.description is string && p.description.size() <= 10000));
    }

    function isValidOrder(o) {
      return o.orderNumber is string && o.orderNumber.size() > 0 && o.orderNumber.size() <= 50
        && o.items is list && o.items.size() > 0 && o.items.size() <= 100
        && o.grandTotal is number && o.grandTotal >= 0
        && o.customerInfo is map
        && o.paymentMethod is string && o.paymentMethod.size() <= 50
        && o.status is string && o.status.size() <= 50;
    }

    function isValidCoupon(c) {
      return c.code is string && c.code.size() > 0 && c.code.size() <= 50
        && c.discountType is string
        && c.discountValue is number && c.discountValue >= 0;
    }

    function isValidReview(r) {
      return r.productId is string && r.productId.size() <= 128
        && r.userName is string && r.userName.size() > 0 && r.userName.size() <= 100
        && r.rating is number && r.rating >= 1 && r.rating <= 5
        && r.comment is string && r.comment.size() <= 2000;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products collection: Public catalog readable by all shoppers across all devices
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId);
      allow delete: if isValidId(productId);
    }

    // Orders collection: Shoppers can place orders, track orders by ID, and admin can update status
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow create, update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }

    // Coupons collection: Publicly readable for cart validation, managed by admin
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update: if isValidId(couponId) && isValidCoupon(request.resource.data);
      allow delete: if isValidId(couponId);
    }

    // Settings collection: Global store settings and MFS details
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Reviews collection: Publicly readable product feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(request.resource.data);
      allow update, delete: if isValidId(reviewId) && isSignedIn();
    }

    // Users collection: Optional customer profile accounts
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
